{
  "*": {
    "box-sizing": "inherit"
  },
  ".clearfix:after": {
    "clear": "both",
    "content": "\" \"",
    "display": "block"
  },
  ".clickable": {
    "cursor": "pointer"
  },
  ".fadeOut": {
    "animation-duration": ".2s",
    "animation-fill-mode": "forwards",
    "animation-iteration-count": "1",
    "animation-name": "f"
  },
  ".fadeOutToLeft": {
    "animation-duration": ".4s",
    "animation-fill-mode": "forwards",
    "animation-iteration-count": "1",
    "animation-name": "a"
  },
  ".ie6 input": {
    "vertical-align": "text-bottom"
  },
  ".ie7 img": {
    "-ms-interpolation-mode": "bicubic"
  },
  ".ie7 input[type=checkbox]": {
    "vertical-align": "baseline"
  },
  ":after": {
    "box-sizing": "inherit"
  },
  ":before": {
    "box-sizing": "inherit"
  },
  "@keyframes a :: 0%": {
    "opacity": "1",
    "transform": "translateX(0)"
  },
  "@keyframes a :: to": {
    "opacity": "0",
    "transform": "translateX(-20px)"
  },
  "@keyframes b :: 0%": {
    "transform": "rotate(0deg)"
  },
  "@keyframes b :: to": {
    "transform": "rotate(1turn)"
  },
  "@keyframes c :: 0%": {
    "box-shadow": "0 1px 5px transparent"
  },
  "@keyframes c :: to": {
    "box-shadow": "0 1px 5px rgba(0,0,0,.22)"
  },
  "@keyframes d :: 0%": {
    "opacity": "0",
    "transform": "translateY(-20px)"
  },
  "@keyframes d :: to": {
    "opacity": "1",
    "transform": "translateY(0)"
  },
  "@keyframes e :: 0%": {
    "opacity": "0"
  },
  "@keyframes e :: to": {
    "opacity": "1"
  },
  "@keyframes f :: 0%": {
    "opacity": "1"
  },
  "@keyframes f :: to": {
    "opacity": "0"
  },
