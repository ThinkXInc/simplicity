  },
  "button.LoadButton": {
    "background-color": "#f9f9f9",
    "border": "1px solid #ccc",
    "box-shadow": "0 0 0 0 transparent",
    "height": "50px",
    "overflow": "hidden",
    "position": "relative",
    "text-align": "center",
    "transition": "width .2s cubic-bezier(.65,0,.34,1),border-radius .2s cubic-bezier(.65,0,.34,1),background-color .2s cubic-bezier(.65,0,.34,1),box-shadow .2s cubic-bezier(.65,0,.34,1)",
    "width": "150px"
  },
  "button.LoadButton img.LoadButtonLoader": {
    "left": "50%",
    "opacity": "0",
    "position": "absolute",
    "top": "50%",
    "transform": "translate(-50%,-50%)",
    "transition": "opacity .2s cubic-bezier(.65,0,.34,1),visibility .2s cubic-bezier(.65,0,.34,1),left .1s cubic-bezier(.4,0,.2,1)",
    "visibility": "hidden",
    "width": "31px"
  },
  "button.LoadButton span.LoadButtonLabel": {
    "left": "50%",
    "opacity": "1",
    "position": "absolute",
    "top": "50%",
    "transform": "translate(-50%,-50%)",
    "transition": "opacity .2s cubic-bezier(.65,0,.34,1),visibility .2s cubic-bezier(.65,0,.34,1),left .1s cubic-bezier(.4,0,.2,1)"
  },
  "button.LoadButton.disable": {
    "background-color": "#656565 !important"
  },
  "button.LoadButton.load": {
    "background-color": "#3e3e3e !important"
  },
  "button.LoadButton.load img.LoadButtonLoader": {
    "left": "30px",
    "opacity": "1",
    "visibility": "visible"
  },
  "button.LoadButton.load span.LoadButtonLabel": {
    "left": "20px",
    "opacity": "0",
    "visibility": "hidden"
  },
  "button.LoadButton:hover": {
    "box-shadow": "0 2px 6px rgba(0,0,0,.2)"
  },
  "button:focus": {
    "outline": "none"
  },
