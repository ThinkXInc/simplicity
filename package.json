{
  "name": "simplicity",
  "version": "1.0.0",
  "scripts": {
    "build:js": "gulp watch",
    "test": "node --test 'test/**/*.test.js'",
    "check:manifest": "node scripts/check_manifest.js",
    "check:gallery": "node scripts/check_gallery_coverage.js",
    "preview:gallery": "python3 -m http.server 8000",
    "lint": "node scripts/gen_globals.js && node scripts/lint_gate.js",
    "typecheck": "tsc --noEmit",
    "check:css": "node scripts/css_golden.js",
    "check:screens": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --config playwright.config.js"
  },
  "devDependencies": {
    "@babel/core": "^7.15.5",
    "@babel/preset-env": "^7.15.6",
    "@playwright/test": "1.61.1",
    "babel-loader": "^8.2.2",
    "eslint": "9.39.4",
    "glob": "^10.3.3",
    "globals": "17.7.0",
    "gulp": "^4.0.2",
    "jsdom": "27.0.1",
    "less": "^4.1.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "gulp-concat": "^2.6.1",
    "gulp-cssnano": "^2.1.3",
    "gulp-order": "^1.2.0",
    "gulp-sourcemaps": "^3.0.0",
    "js-cookie": "^3.0.5",
    "onchange": "^7.1.0",
    "sticky-js": "^1.3.0",
    "watch": "^1.0.2"
  }
}
